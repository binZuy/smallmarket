// Prisma Schema for Convenience Store POS Application
// Connected to Supabase PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id           String      @id @default(cuid())
  name         String
  costPrice    Float       // Giá nhập hàng (VNĐ)
  sellingPrice Float       // Giá bán ra (VNĐ)
  unit         String      @default("cái")
  isAvailable  Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  orderItems   OrderItem[]

  @@map("products")
}

model Order {
  id                String      @id @default(cuid())
  orderCode         String      @unique
  totalSellingPrice Float       // Tổng tiền bán ra của đơn hàng
  totalCostPrice    Float       // Tổng tiền nhập của các món trong đơn
  profit            Float       // Lợi nhuận = Tổng bán - Tổng nhập
  notes             String?
  createdAt         DateTime    @default(now())
  items             OrderItem[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  productName  String   // Lưu snapshot tên sản phẩm tại thời điểm bán
  costPrice    Float    // Giá nhập tại thời điểm bán
  sellingPrice Float    // Giá bán tại thời điểm bán
  quantity     Int      @default(1)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Transaction {
  id          String          @id @default(cuid())
  date        DateTime        // Ngày của giao dịch
  type        TransactionType // Thu (INCOME) hoặc Chi (EXPENSE)
  category    String          // Danh mục (VD: Chuyển khoản, Tiền mặt, Nhập nước, Bánh mì...)
  amount      Float           // Số tiền
  quantity    Int?            // Số lượng (VD: bao nhiêu thùng, bao nhiêu cái) - Thường dùng cho Chi
  notes       String?         // Ghi chú thêm
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Employee {
  id          String            @id @default(cuid())
  name        String
  phone       String?
  hourlyRate  Float             @default(25000)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  shifts      ShiftAssignment[]

  @@map("employees")
}

model ShiftAssignment {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         String      // Format: YYYY-MM-DD
  shiftType    ShiftType   @default(MORNING)
  startTime    String      @default("07:00")
  endTime      String      @default("12:30")
  actualHours  Float       @default(5.5)
  status       ShiftStatus @default(SCHEDULED)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@map("shift_assignments")
}

enum ShiftType {
  MORNING
  AFTERNOON
  CUSTOM
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  ABSENT
}

